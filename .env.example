# Copy to .env and fill in. Load with: set -a && . ./.env && set +a
# Every variable corresponds to a CLI option, see `hdns2mikrotik sync --help`.

# Required
API_TOKEN=your-hetzner-api-token
ZONES=example.com,example.org
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your-mikrotik-password

# Optional (defaults shown)
#RECORD_TYPES=A,AAAA,CNAME
#TTL=600

# Watch mode: keep running and re-sync zones whose SOA serial changed
#WATCH=true
#WATCH_INTERVAL=600
#HETZNER_NAMESERVERS=helium.ns.hetzner.de,oxygen.ns.hetzner.com,hydrogen.ns.hetzner.com

# healthchecks.io-style base URL: pinged at <url>/start, <url> and <url>/fail
#HEALTHCHECKSIO_URL=https://hc-ping.com/your-uuid
